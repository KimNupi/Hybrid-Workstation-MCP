{
  "name": "hybrid-workstation-mcp",
  "version": "1.5.0",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "description": "A Windows workstation MCP for ChatGPT developer-mode apps over Secure MCP Tunnel.",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:info": "node scripts/generate-build-info.mjs",
    "build": "npm run build:info && npm run clean && tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:control-center": "powershell.exe -NoProfile -NonInteractive -STA -ExecutionPolicy Bypass -File scripts/test-control-center.ps1",
    "test:tunnel-manager": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-tunnel-manager.ps1",
    "test:permission-presets": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-permission-presets.ps1",
    "test:recovery-policy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-recovery-policy.ps1",
    "performance:check": "node scripts/performance-check.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "check": "npm run build && npm run lint && npm run test:coverage && npm run test:control-center && npm run test:tunnel-manager && npm run test:permission-presets && npm run test:recovery-policy && npm run performance:check && npm run security:audit",
    "control-center": "powershell.exe -NoProfile -NonInteractive -STA -ExecutionPolicy Bypass -File scripts/ControlCenter.ps1",
    "smoke:stdio": "node scripts/stdio-smoke.mjs",
    "smoke:native-shell": "node scripts/native-shell-smoke.mjs",
    "smoke:window": "node scripts/window-smoke.mjs",
    "release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Release.ps1",
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Native.ps1",
    "windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Manage-Window-Grants.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "4.1.2"
  }
}
